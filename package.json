{
  "name": "orange_anonymization_fe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "preview": "vite preview",
    "prepare": "husky",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=istanbul --coverage.all=true --coverage.include='src/**/*.{ts,tsx}' --coverage.exclude='src/test/**' --coverage.exclude='src/**/*.types.ts' --coverage.exclude='src/**/types.ts' --coverage.exclude='src/main.tsx' --coverage.exclude='src/vite-env.d.ts' --coverage.exclude='src/**/*.d.ts' --coverage.reporter=text-summary --coverage.reporter=json --coverage.reportsDirectory=coverage-unit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:coverage": "rimraf .nyc_output coverage-e2e && cross-env VITE_COVERAGE=true playwright test && nyc report --reporter=text-summary --reporter=html --report-dir=coverage-e2e --temp-dir=.nyc_output",
    "test:coverage:all": "rimraf .nyc_output coverage-unit coverage-e2e coverage-combined && npm run test:coverage && mkdir -p .nyc_output && cp coverage-unit/coverage-final.json .nyc_output/from-vitest.json && cross-env VITE_COVERAGE=true playwright test && nyc report --reporter=text-summary --reporter=html --report-dir=coverage-combined --temp-dir=.nyc_output"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@reduxjs/toolkit": "^2.11.2",
    "@tailwindcss/vite": "^4.2.2",
    "axios": "^1.13.6",
    "date-fns": "^4.3.0",
    "dayjs": "^1.11.20",
    "framer-motion": "^12.38.0",
    "i18next": "^25.10.5",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.2",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
    "react-i18next": "^16.6.2",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.13.2",
    "recharts": "^3.8.1",
    "redux-persist": "^6.0.0",
    "vite-plugin-svgr": "^5.2.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/pdfjs-dist": "^2.10.377",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/redux-persist": "^4.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-istanbul": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.0",
    "lint-staged": "^16.4.0",
    "nyc": "^18.0.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vite-plugin-istanbul": "^8.0.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
